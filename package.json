{
  "name": "faith-forge-web",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "dev:stack": "docker compose -f docker-compose.stack.yml up --build",
    "dev:stack:reset": "docker compose -f docker-compose.stack.yml down -v && docker compose -f docker-compose.stack.yml up --build",
    "dev:stack:down": "docker compose -f docker-compose.stack.yml down",
    "build": "tsc && NODE_OPTIONS=\"--experimental-global-webcrypto\" vite build",
    "start": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@reduxjs/toolkit": "^1.9.6",
    "@types/lodash": "^4.17.16",
    "@vitejs/plugin-react": "^4.7.0",
    "@yudiel/react-qr-scanner": "^2.0.8",
    "axios": "^1.5.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.10",
    "framer-motion": "^13.1.1",
    "lodash": "^4.17.21",
    "lucide-react": "^1.33.0",
    "luxon": "^3.4.3",
    "pica": "^9.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.56.4",
    "react-icons": "^5.3.0",
    "react-qrcode-logo": "^3.0.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.30.6",
    "redux-persist": "^6.0.0",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.13",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "^29.5.12",
    "@types/luxon": "^3.3.2",
    "@types/next-pwa": "^5.6.5",
    "@types/node": "18.16.9",
    "@types/pica": "^9.0.4",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "2.30.0",
    "eslint-plugin-jsx-a11y": "6.10.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.5.2"
  }
}
